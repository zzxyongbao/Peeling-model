class Scroll(tk.Frame):
    def __init__(self, master):
        super().__init__(master, bg=PANEL)
        c = tk.Canvas(self, bg=PANEL, highlightthickness=0)
        s = ttk.Scrollbar(self, orient="vertical", command=c.yview)
        self.inner = tk.Frame(c, bg=PANEL)
        w = c.create_window((0,0), window=self.inner, anchor="nw")
        self.inner.bind("<Configure>", lambda e: c.configure(scrollregion=c.bbox("all")))
        c.bind("<Configure>", lambda e: c.itemconfigure(w, width=e.width))
        c.configure(yscrollcommand=s.set)
        c.pack(side="left", fill="both", expand=True)
        s.pack(side="right", fill="y")


def section(parent, title):
    f = tk.LabelFrame(
        parent, text=title, bg=PANEL2, fg=ACC,
        font=("Segoe UI",10,"bold"), padx=9, pady=7
    )
    f.pack(fill="x", padx=9, pady=5)
    return f


def field(parent, label, var, unit, row):
    tk.Label(parent,text=label,bg=PANEL2,fg=TEXT).grid(row=row,column=0,sticky="w",pady=3)
    tk.Entry(parent,textvariable=var,bg="#0b1728",fg=TEXT,insertbackground=TEXT,relief="flat").grid(
        row=row,column=1,sticky="ew",padx=6
    )
    tk.Label(parent,text=unit,bg=PANEL2,fg=MUTED).grid(row=row,column=2,sticky="w")
    parent.grid_columnconfigure(1,weight=1)


