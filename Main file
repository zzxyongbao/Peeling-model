    def example(self):
        # Paper-based defaults:
        # Chen (2002) Figure-3/reference set: E=4 GPa, nu=0.40,
        # sigma_y=100 MPa, alpha=0.05, R=100 J/m^2 and h/r_y=10.
        # Eq. (13) gives h ≈ 50.53 um for that reference set.
        #
        # The adhesive layer is the later series-foundation extension and is
        # not specified by Chen (2002), so the previously agreed adhesive
        # reference values are retained here.
        vals=[
            (self.E,"0.4"),(self.nu,"0.40"),(self.sy,"100"),(self.alpha,"0.05"),
            (self.b,"10"),(self.h,"50.53"),(self.Ea,"1.0"),(self.nua,"0.44"),
            (self.ba,"10"),(self.ha,"10"),(self.P,"0.5"),(self.phi,"90"),
        ]
        for v,x in vals:
            v.set(x)

    def parse(self):
        f=Film(
            float(self.E.get())*1e9,float(self.nu.get()),float(self.sy.get())*1e6,
            float(self.alpha.get()),float(self.b.get())*1e-3,float(self.h.get())*1e-6
        )
        a=Adhesive(
            float(self.Ea.get())*1e9,float(self.nua.get()),
            float(self.ba.get())*1e-3,float(self.ha.get())*1e-6
        )
        validate_film(f)
        validate_adhesive(a)
        P=float(self.P.get())
        phi=deg(float(self.phi.get()))
        if P<0:
            raise ValueError("Peel force cannot be negative.")
        if not (0<phi<=math.pi):
            raise ValueError("Peel angle must be in (0,180] deg.")
        return f,a,P,phi

    def clear(self):
        for item in self.tree.get_children(): self.tree.delete(item)
        self.txt.delete("1.0","end")

    def calculate(self):
        try:
            f,a,P,phi=self.parse()
            self.clear()

            # v26: only the k1-k2 series foundation is used.
            results=[solve_auto(f,a,P,phi)]

            for r in results:
                self.tree.insert("", "end", values=(
                    r.name,f"{r.peel.theta_deg:.8f}",f"{r.peel.kappa_m:.8f}",
                    f"{r.k_used:.6e}",f"{r.beta:.6e}",f"{r.length_scale*1e3:.6f}",
                    f"{r.peel.R:.6f}",f"{r.residual:.3e}"
                ))

            r=results[0]
            self.primary.config(text=(
                f"theta_r = {r.peel.theta_deg:.8f} deg\n"
                f"kappa_m = {r.peel.kappa_m:.8f}\n"
                f"K_m = {r.peel.K_m:.6e} 1/m\n"
                f"y(0) = {r.y0*1e6:.6f} um\n"
                f"R = {r.peel.R:.6f} J/m²"
            ))

            summary=self.detail_auto(results)
            self.txt.insert("1.0",summary)

            self.last_results=results
            self.last_inputs={
                "film":f,
                "adhesive":a,
                "P":P,
                "phi":phi,
                "timestamp":datetime.now(),
                "summary":summary,
            }

        except Exception as e:
            messagebox.showerror("Calculation error",str(e))


    def clear_output(self):
        """Clear all visible calculation output and reset stored calculation state."""
        # Clear the detailed text output.
        self.txt.delete("1.0", "end")

        # Reset the primary result area.
        self.primary.config(text="Ready.")

        # Clear the model-comparison/result table.
        for item in self.tree.get_children():
            self.tree.delete(item)

        # Clear stored state so stale results cannot be exported.
        self.last_results = None
        self.last_inputs = None


    def export_excel(self):
        if not self.last_results or not self.last_inputs:
            messagebox.showinfo(
                "Export Excel",
                "Please run CALCULATE first, then export the current results."
            )
            return

        default_name="peeling_results_" + datetime.now().strftime("%Y%m%d_%H%M%S") + ".xlsx"
        path=filedialog.asksaveasfilename(
            title="Export calculation results to Excel",
            defaultextension=".xlsx",
            initialfile=default_name,
            filetypes=[("Excel Workbook","*.xlsx")]
        )
        if not path:
            return

        try:
            self._write_excel_file(path)
            messagebox.showinfo("Export Excel",f"Excel file exported successfully:\n{path}")
        except ModuleNotFoundError:
            messagebox.showerror(
                "Excel export dependency missing",
                "Excel export requires the 'xlsxwriter' package.\n\n"
                "Install it once with:\n"
                "pip install xlsxwriter"
            )
        except Exception as exc:
            messagebox.showerror("Export Excel",str(exc))

    def _write_excel_file(self,path):
        # Lazy import: GUI calculation does not require this optional dependency.
        import xlsxwriter

        data=self.last_inputs
        results=self.last_results
        f=data["film"]
        a=data["adhesive"]

        wb=xlsxwriter.Workbook(path)
        ws=wb.add_worksheet("Peeling Results")

        title_fmt=wb.add_format({
            "bold":True,"font_size":16,"font_color":"#FFFFFF",
            "bg_color":"#173654","align":"center","valign":"vcenter"
        })
        section_fmt=wb.add_format({
            "bold":True,"font_color":"#FFFFFF","bg_color":"#1F4E78",
            "border":1
        })
        header_fmt=wb.add_format({
            "bold":True,"font_color":"#FFFFFF","bg_color":"#4472C4",
            "border":1,"align":"center"
        })
        label_fmt=wb.add_format({"bold":True,"bg_color":"#D9EAF7","border":1})
        value_fmt=wb.add_format({"border":1,"num_format":"0.000000000"})
        sci_fmt=wb.add_format({"border":1,"num_format":"0.000000E+00"})
        text_fmt=wb.add_format({"border":1})
        wrap_fmt=wb.add_format({"text_wrap":True,"valign":"top","border":1})

        ws.merge_range("A1:H2","Elastoplastic Peeling Analysis — v28 Results",title_fmt)
        ws.set_row(0,22)
        ws.set_column("A:A",28)
        ws.set_column("B:B",18)
        ws.set_column("C:H",18)

        row=3
        ws.write(row,0,"Run Information",section_fmt); row+=1
        info=[
            ("Timestamp",data["timestamp"].strftime("%Y-%m-%d %H:%M:%S")),
            ("Model","Revised Chen elastic foundation — No FPZ"),
            ("Boundary matching","y, y', y'' at x=0"),
            ("Root-angle mode","Automatic only"),
        ]
        for label,val in info:
            ws.write(row,0,label,label_fmt); ws.write(row,1,val,text_fmt); row+=1

        row+=1
        ws.write(row,0,"Input Parameters",section_fmt); row+=1
        inputs=[
            ("Film E_f [GPa]",f.E/1e9),
            ("Film nu_f [-]",f.nu),
            ("Film sigma_y [MPa]",f.sigma_y/1e6),
            ("Hardening alpha [-]",f.alpha),
            ("Film width b_f [mm]",f.b*1e3),
            ("Film thickness h_f [um]",f.h*1e6),
            ("Adhesive E_a [GPa]",a.E/1e9),
            ("Adhesive nu_a [-]",a.nu),
            ("Adhesive width b_a [mm]",a.b*1e3),
            ("Adhesive thickness h_a [um]",a.h*1e6),
            ("Peel force P [N]",data["P"]),
            ("Peel angle phi [deg]",rad2deg(data["phi"])),
            ("External force boundary","V = P sin(phi)"),
        ]
        for label,val in inputs:
            ws.write(row,0,label,label_fmt)
            if isinstance(val,(int,float)):
                ws.write_number(row,1,float(val),value_fmt)
            else:
                ws.write(row,1,str(val),text_fmt)
            row+=1

        row+=1
        ws.write(row,0,"Calculation Results",section_fmt); row+=1
        headers=[
            "Model","theta_r [deg]","kappa_m","K_m [1/m]",
            "k [N/m^2]","beta [1/m]","1/beta [mm]","R [J/m^2]"
        ]
        for col,h in enumerate(headers):
            ws.write(row,col,h,header_fmt)
        row+=1

        for r in results:
            vals=[
                r.name,r.peel.theta_deg,r.peel.kappa_m,r.peel.K_m,
                r.k_used,r.beta,r.length_scale*1e3,r.peel.R
            ]
            ws.write(row,0,vals[0],text_fmt)
            for c,val in enumerate(vals[1:],start=1):
                ws.write_number(row,c,float(val),sci_fmt if c in (3,4,5) else value_fmt)
            row+=1

        primary=results[0]
        row+=1
        ws.write(row,0,"Primary Series-Foundation Details",section_fmt); row+=1
        details=[
            ("k1 film [N/m^2]",primary.k1),
            ("k2 adhesive [N/m^2]",primary.k2 if primary.k2 is not None else None),
            ("k_series [N/m^2]",primary.k_series),
            ("E_eq [GPa]",primary.Eeq/1e9),
            ("nu_eq [-]",primary.nueq),
            ("E'_eq [GPa]",primary.Eprime_eq/1e9),
            ("I_f [m^4]",primary.I_f),
            ("D_att [N m^2]",primary.D_att),
            ("Root displacement y(0) [um]",primary.y0*1e6),
            ("Foundation constant A [m]",primary.A),
            ("Foundation constant B [m]",primary.B),
            ("Foundation slope y'(0) [rad]",primary.slope_foundation),
            ("Slope residual [rad]",primary.slope_residual),
            ("third derivative y'''(0) [1/m^2]",primary.yppp0),
            ("V_att [N]",primary.V_att),
            ("V_peel [N]",primary.V_peel),
            ("Force residual [N]",primary.force_residual),
            ("K_foundation [1/m]",primary.K_foundation),
            ("Curvature residual [1/m]",primary.residual),
            ("External work [J/m^2]",primary.peel.external),
            ("Bending work [J/m^2]",primary.peel.bending),
            ("Tensile work [J/m^2]",primary.peel.tensile),
            ("M_root [N m]",primary.peel.M_root),
        ]
        for label,val in details:
            ws.write(row,0,label,label_fmt)
            if val is None:
                ws.write(row,1,"N/A",text_fmt)
            else:
                ws.write_number(row,1,float(val),sci_fmt if abs(float(val))>=1e5 or (abs(float(val))<1e-4 and val!=0) else value_fmt)
            row+=1

        row+=1
        ws.write(row,0,"Detailed Output",section_fmt); row+=1
        ws.merge_range(row,0,row+18,7,data["summary"],wrap_fmt)
        ws.set_row(row,220)

        ws.freeze_panes(3,0)
        wb.close()

