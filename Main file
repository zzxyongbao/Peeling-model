def self_test():
    f=Film(4e9,0.40,100e6,0.05,10e-3,50e-6)
    a=Adhesive(0.10e9,0.44,10e-3,10e-6)

    k1,k2,ks=foundation_series(f,a)
    assert k2 is not None and ks<k1 and ks<k2

    Eeq,nueq,Ep,I,D=attached_properties(f,a)
    assert abs(Eeq/1e9-0.5333333333333333)<1e-12

    r=solve_auto(f,a,0.5,deg(90))
    assert 0<r.peel.theta<deg(90)
    assert abs(r.residual)<1e-6
    assert abs(r.slope_residual)<1e-9
    assert abs(r.force_residual)<1e-8
    assert math.isfinite(r.y0)

    known=peel_result(f,0.5,deg(90),deg(6))
    assert abs(known.R-39.845289778749176)<1e-8

    a0=Adhesive(0.1e9,0.44,10e-3,0.0)
    k10,k20,ks0=foundation_series(f,a0)
    assert k20 is None and abs(k10-ks0)/k10<1e-14

    return {
        "k1_N_m2":k1,
        "k2_N_m2":k2,
        "k_series_N_m2":ks,
        "Eeq_GPa":Eeq/1e9,
        "nueq":nueq,
        "auto_theta_deg":r.peel.theta_deg,
        "auto_kappa_m":r.peel.kappa_m,
        "auto_R_J_m2":r.peel.R,
        "curvature_residual_1_m":r.residual,
        "known_R_J_m2":known.R,
    }


